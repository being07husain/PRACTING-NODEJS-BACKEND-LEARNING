<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MiniMart | Products</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f6fa;
            color: #222;
        }


        /* ================= NAVBAR ================= */

        nav {
            background: #111827;
            padding: 18px 8%;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            color: white;
            font-size: 24px;
        }

        nav div {
            display: flex;
            align-items: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 15px;
            transition: 0.2s;
        }

        nav a:hover {
            color: #60a5fa;
        }


        /* ================= CONTAINER ================= */

        .container {
            width: 84%;
            max-width: 1200px;
            margin: 50px auto;
        }

        .container h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }


        /* ================= PRODUCT GRID ================= */

        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }


        /* ================= PRODUCT CARD ================= */

        .product-card {
            background: white;
            padding: 20px;

            border-radius: 12px;

            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);

            transition: 0.2s;
        }

        .product-card:hover {
            transform: translateY(-4px);

            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }


        /* ================= PRODUCT ICON ================= */

        .product-icon {
            height: 160px;

            background: #eef2ff;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 60px;

            border-radius: 10px;

            margin-bottom: 20px;
        }


        /* ================= CATEGORY ================= */

        .category {
            color: #2563eb;

            font-size: 14px;

            font-weight: bold;

            margin-bottom: 8px;

            text-transform: uppercase;
        }


        /* ================= PRODUCT NAME ================= */

        .product-card h2 {
            font-size: 21px;

            margin-bottom: 10px;
        }


        /* ================= BRAND ================= */

        .brand {
            color: #666;

            font-size: 14px;

            margin-bottom: 10px;
        }


        /* ================= PRICE ================= */

        .price {
            font-size: 22px;

            font-weight: bold;

            margin: 15px 0;
        }


        /* ================= STOCK ================= */

        .stock {
            color: #555;

            margin-bottom: 20px;

            font-size: 14px;
        }


        /* ================= BUTTON ================= */

        .btn {
            display: block;

            width: 100%;

            background: #2563eb;

            color: white;

            padding: 11px 18px;

            text-align: center;

            text-decoration: none;

            border-radius: 7px;

            font-size: 15px;

            font-weight: bold;

            transition: 0.2s;
        }

        .btn:hover {
            background: #1d4ed8;
        }


        /* ================= EMPTY PRODUCTS ================= */

        .empty-message {
            background: white;

            padding: 40px;

            text-align: center;

            border-radius: 10px;

            color: #666;
        }


        /* ================= TABLET ================= */

        @media (max-width: 900px) {

            .container {
                width: 90%;
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        /* ================= MOBILE ================= */

        @media (max-width: 600px) {

            nav {
                padding: 15px 5%;

                flex-direction: column;

                gap: 15px;
            }

            nav div {
                width: 100%;

                justify-content: center;
            }

            nav a {
                margin: 0 8px;

                font-size: 14px;
            }

            .container {
                width: 92%;

                margin: 30px auto;
            }

            .container h1 {
                font-size: 27px;
            }

            .product-grid {
                grid-template-columns: 1fr;
            }

        }
    </style>

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <nav>

        <h2>🛒 MiniMart</h2>

        <div>

            <a href="/">
                Home
            </a>

            <a href="/products">
                Products
            </a>

            <a href="/sell">
                Sell Products
            </a>
            <a href="/manageProducts">Manage Products</a>
        </div>

    </nav>


    <!-- ================= MAIN ================= -->

    <main class="container">

        <h1>
            All Products
        </h1>

        <p class="subtitle">
            Explore our complete collection of products.
        </p>


        <% if (products.length===0) { %>

            <div class="empty-message">

                <h2>
                    No Products Available
                </h2>

                <p>
                    Be the first person to sell a product!
                </p>

            </div>

            <% } else { %>


                <div class="product-grid">


                    <% products.forEach(product=> { %>


                        <div class="product-card">


                            <!-- PRODUCT ICON -->

                            <div class="product-icon">

                                <% if (product.category==="Clothes" ) { %>

                                    👕


                                    <% } else if (product.category==="Electronics" ) { %>

                                        💻


                                        <% } else if (product.category==="Accessories" ) { %>

                                            🎧


                                            <% } else if (product.category==="Sports Equipment" ) { %>

                                                ⚽


                                                <% } else { %>

                                                    🌸

                                                    <% } %>

                            </div>


                            <!-- CATEGORY -->

                            <p class="category">

                                <%= product.category %>

                            </p>


                            <!-- PRODUCT NAME -->

                            <h2>

                                <%= product.name %>

                            </h2>


                            <!-- BRAND -->

                            <p class="brand">

                                Brand: <%= product.brand %>

                            </p>


                            <!-- PRICE -->

                            <p class="price">

                                ₹<%= product.price %>

                            </p>


                            <!-- STOCK -->

                            <p class="stock">

                                Available: <%= product.quantity %>

                            </p>


                            <!-- DETAILS BUTTON -->

                            <a href="/products/<%= product.id %>" class="btn">

                                View Details

                            </a>


                        </div>


                        <% }) %>


                </div>


                <% } %>


    </main>


</body>

</html>